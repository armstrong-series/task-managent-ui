{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vite/client","vue", "node"]
  },

  "include": ["src/*", "src/**/*", "src/**/*.vue", "vite.config.ts", "src/router/**/*"],
  "exclude": ["node_modules", "dist"]
}